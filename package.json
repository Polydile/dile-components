{
  "name": "dile-components",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "version": "2.1.0",
  "description": "Dile Components new repo",
  "scripts": {
    "dev": "vite",
    "test": "node --test packages/crud/lib/image/*.test.js",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "lerna": "lerna",
    "yalc:publish:all": "lerna exec --concurrency 1 --stream -- yalc publish",
    "yalc:push:all": "lerna exec --concurrency 1 --stream -- yalc publish --push",
    "start": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy && node llm/generate-llms_txt.js",
    "generate:lucide-icons": "node icons-generators/generate-lucide-icon-components.js",
    "generate:material-icons": "node icons-generators/generate-material-icon-components.js",
    "generate:fontawesome-brand-icons": "node icons-generators/generate-fontawesome-brand-icon-components.js",
    "generate:fontawesome-icons": "node icons-generators/generate-fontawesome-icon-components.js",
    "generate:fontawesome-regular-icons": "node icons-generators/generate-fontawesome-regular-icon-components.js",
    "generate:phosphor-icons": "node icons-generators/generate-phosphor-icon-components.js",
    "generate:tabler-icons": "node icons-generators/generate-tabler-icon-components.js",
    "generate:remixicon-icons": "node icons-generators/generate-remixicon-icon-components.js",
    "generate:icons": "npm run generate:lucide-icons && npm run generate:material-icons && npm run generate:fontawesome-icons && npm run generate:fontawesome-regular-icons && npm run generate:fontawesome-brand-icons && npm run generate:phosphor-icons && npm run generate:tabler-icons && npm run generate:remixicon-icons",
    "generate:icon-catalog": "node icons-catalog/generate-icon-catalog.js",
    "apply:icon-keywords": "node icons-catalog/apply-keywords-dictionary.js",
    "export:icon-catalog": "node icons-catalog/export-for-laravel.js",
    "build:icon-catalog": "npm run generate:icon-catalog && npm run apply:icon-keywords && npm run export:icon-catalog",
    "sync:icon-catalog": "node icons-catalog/sync-icons-to-laravel.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Polydile/dile-components"
  },
  "keywords": [
    "web",
    "components",
    "dile",
    "ui"
  ],
  "author": "EscuelaIT",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "lerna": "^10.0.0",
    "playwright": "^1.61.1",
    "vite": "^6.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-vite": "^6.0.0",
    "@reduxjs/toolkit": "^2.8.2",
    "jsdom": "^24.0.0",
    "lit": "^2.7.0 || ^3.0.0",
    "markdown-it-attrs": "^4.3.1"
  }
}
