# Servidor Laravel de desarrollo (usado por defecto por icons-catalog/sync-icons-to-laravel.js)
ICONS_API_SERVER=http://localhost

# Servidor Laravel de producción (usado con --prod)
ICONS_API_SERVER_PROD=

# Llave enviada como header X-Icons-Sync-Key al endpoint /api/admin/icons/sync
ICONS_SYNC_KEY=

# Opcional: llave específica de producción. Si no se define, se usa ICONS_SYNC_KEY como fallback en --prod
ICONS_SYNC_KEY_PROD=
